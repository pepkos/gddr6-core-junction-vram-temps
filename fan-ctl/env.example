# Copy to /etc/gpu-fan/env (chmod 600) and edit. Do NOT commit the real file.

# --- BMC (MegaRAC web API) ---
BMC_IP=192.168.3.4
BMC_USER=fan_controller
BMC_PASS=change-me

# --- telemetry source ---
GPU_BIN=/home/pepkos/gddr6-core-junction-vram-temps/gputemps

# --- fan zone: BMC zone index. On this board:
#     0 = Zone1(CPU_FAN & CPU_OPT)
#     1 = Zone2(CHA_FAN 1)   <- chassis fans
#     2..6 = Zone3..7(CHA_FAN 2..6)
ZONE=1

# --- behavior ---
INTERVAL=1          # seconds between readings
MIN_DUTY=30         # floor (%); also the value used at the coldest curve point
MAX_DUTY=100        # ceiling (%)
FAIL_DUTY=100       # duty on telemetry loss / clean stop (no BMC auto-fallback here)
ON_EXIT=high        # high | keep  -> what to do on clean stop
RATE_UP=12          # max % increase per cycle
RATE_DN=5           # max % decrease per cycle
DEADBAND=2          # ignore changes smaller than +/- (%)
STALE_S=5           # treat telemetry older than this (s) as invalid
MIN_GPUS=1          # require at least this many GPUs in the reading
