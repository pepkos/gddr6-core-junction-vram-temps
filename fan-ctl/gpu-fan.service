[Unit]
Description=GPU VRAM driven chassis fan controller (CHA_FAN1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/gpu-fan/env
ExecStart=/usr/bin/python3 /usr/local/bin/gpu_fan_ctl.py --apply
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
